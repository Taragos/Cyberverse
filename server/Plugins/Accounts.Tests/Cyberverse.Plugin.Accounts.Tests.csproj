<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the accounts plugin against real PostgreSQL and Keycloak containers (Testcontainers). They need Docker or
    Podman with Linux containers and skip themselves without (e.g. on the Windows CI runner).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cyberverse.Plugin.Accounts.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.Keycloak" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server (for the real auth plugin and plugin host) and the plugin, both loaded normally here. -->
    <ProjectReference Include="..\..\Managed\Cyberverse.Server.csproj" />
    <ProjectReference Include="..\Accounts\Cyberverse.Plugin.Accounts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\deploy\keycloak\cyberverse-realm.json" Link="cyberverse-realm.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
