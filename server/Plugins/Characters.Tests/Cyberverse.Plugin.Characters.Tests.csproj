<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the characters plugin against a real PostgreSQL container (Testcontainers). The name rules run anywhere;
    the database tests need Docker or Podman with Linux containers and skip themselves without (e.g. on Windows CI).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cyberverse.Plugin.Characters.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Managed\Cyberverse.Server.csproj" />
    <ProjectReference Include="..\Characters\Cyberverse.Plugin.Characters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
