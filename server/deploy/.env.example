# Copy to .env next to compose.yaml and change every value before the server is reachable from outside.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# The game server's Keycloak client secret; imported into the realm on Keycloak's first start.
CYBERVERSE_CLIENT_SECRET=change-me
# Where players' browsers reach Keycloak. Behind a reverse proxy: https://auth.example.com
KEYCLOAK_PUBLIC_URL=http://localhost:8080
