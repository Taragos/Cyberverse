# The mod version the client sends at login: `git describe` of the checkout, e.g. v0.1.0-12-gaba70a7-dirty, or
# CYBERVERSE_VERSION when it is set (a build without .git). The server stamps the same string in its .csproj.
#
# include() it and call cyberverse_version_header(<target>): every build regenerates CyberverseVersion.h with
#   constexpr const char* CYBERVERSE_VERSION = "...";
# and rewrites it only when the version changed, so an unchanged checkout doesn't recompile anything.
# In script mode (cmake -P) it is that regeneration step.

if(CMAKE_SCRIPT_MODE_FILE)
  if(CYBERVERSE_VERSION)
    set(version "${CYBERVERSE_VERSION}")
  else()
    # safe.directory: build containers run as another user than the one owning the checkout.
    execute_process(
      COMMAND git -c safe.directory=* describe --tags --always --dirty --match "v[0-9]*"
      WORKING_DIRECTORY "${SOURCE_DIR}"
      OUTPUT_VARIABLE version
      OUTPUT_STRIP_TRAILING_WHITESPACE
      ERROR_QUIET
      RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR version STREQUAL "")
      set(version "unknown")
    endif()
  endif()

  set(content "// Generated by shared/version/CyberverseVersion.cmake at build time.\n#pragma once\n\nconstexpr const char* CYBERVERSE_VERSION = \"${version}\";\n")
  if(EXISTS "${OUT}")
    file(READ "${OUT}" current)
  endif()
  if(NOT current STREQUAL content)
    file(WRITE "${OUT}" "${content}")
    message(STATUS "Cyberverse version ${version}")
  endif()
  return()
endif()

set(CYBERVERSE_VERSION_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")
set(CYBERVERSE_VERSION "" CACHE STRING "Mod version to stamp instead of git describe (for builds without .git)")

function(cyberverse_version_header target)
  set(dir "${CMAKE_CURRENT_BINARY_DIR}/cyberverse-version")
  set(header "${dir}/CyberverseVersion.h")
  file(MAKE_DIRECTORY "${dir}")
  add_custom_target(${target}_version ALL
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${header}" "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}"
            "-DCYBERVERSE_VERSION=${CYBERVERSE_VERSION}" -P "${CYBERVERSE_VERSION_SCRIPT}"
    BYPRODUCTS "${header}"
    COMMENT "Stamping the Cyberverse version"
    VERBATIM)
  add_dependencies(${target} ${target}_version)
  target_include_directories(${target} PRIVATE "${dir}")
endfunction()
